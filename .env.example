# ==========================================
# Loose AI - Developer Showcase .env
# ==========================================

# Core API Keys
LOOSE_API_KEY=ls-your-key-here
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Search & Tools
SERPAPI_API_KEY=...
GOOGLE_API_KEY=...

# Infrastructure
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...
LIVEKIT_URL=wss://your-project.livekit.cloud

# Note: Many examples support "Mock Mode" and will run 
# even without keys for demonstration purposes.
